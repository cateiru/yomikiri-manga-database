# compose.prod.yaml（本番バッチ）用の秘匿情報テンプレート。
# `cp .env.example .env` してから値を埋める。.env は .gitignore 対象。
#
# 注意: この .env はプロジェクト直下にあるため、各サービスの env_file としてだけでなく
# docker compose 自身の ${VAR} 変数展開にも自動で使われる。値の中に $ をそのまま書くと
# 「未定義変数への参照」として解釈され、$ 以降が消えてしまう（例: p$ssw0rd -> p のみ残る）。
# パスワード等に $ を含む場合は $$ とエスケープすること。

# apps/batch（batch サービス）が使う
DATABASE_URL=postgres://user:password@host:5432/dbname

# mackerel-agent サービスが使う（変数名は小文字の "apikey" 固定。
# Docker公式イメージ mackerel/mackerel-agent の startup.sh がこの名前で読む）
apikey=

# otelcol-mackerel サービスが使う（変数名は "MACKEREL_APIKEY" 固定）
MACKEREL_APIKEY=
